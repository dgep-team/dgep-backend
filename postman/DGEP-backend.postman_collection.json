{
  "info": {
    "name": "DGEP backend (MVP)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Works against staging (seeded demo data). Run \"0. Log in\" first: tokens are saved for the other folders. For local, set baseUrl to http://localhost:3000 and run npm run db:seed."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://dgep-backend-staging.onrender.com"
    },
    {
      "key": "password",
      "value": "Password123!"
    },
    {
      "key": "guestToken",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "hotelId",
      "value": "00000000-0000-4000-8000-000000000101"
    },
    {
      "key": "roomTypeId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "reference",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "staffId",
      "value": "00000000-0000-4000-8000-000000000203"
    },
    {
      "key": "newHotelId",
