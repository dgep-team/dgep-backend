  "item": [
    {
      "name": "0. Log in (saves tokens)",
      "item": [
        {
          "name": "Guest: John",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.accessToken) pm.collectionVariables.set('guestToken', d.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Staff: Eko manager",
          "request": {
