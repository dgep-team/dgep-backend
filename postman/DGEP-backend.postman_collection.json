    {
      "name": "1. Browse (no login)",
      "item": [
        {
          "name": "Hotels in Lagos",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/hotels?city=Lagos"
          }
        },
        {
          "name": "Hotel with prices (copy a roomType id -> roomTypeId)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/hotels/{{hotelId}}?checkIn=2026-12-10&checkOut=2026-12-12&guests=2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json().data.roomTypes.find((x) => x.availableRooms > 0);",
                  "if (t) pm.collectionVariables.set('roomTypeId', t.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Compare room types",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/room-types/compare?ids={{roomTypeId}}&checkIn=2026-12-10&checkOut=2026-12-12"
          }
        }
      ]
    },
    {
      "name": "2. Book and pay",
      "item": [
        {
          "name": "Book (logged in)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{guestToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomTypeId\": \"{{roomTypeId}}\",\n  \"checkIn\": \"2026-12-10\",\n  \"checkOut\": \"2026-12-12\",\n  \"guests\": 2,\n  \"addOns\": [\n    \"AIRPORT_PICKUP\",\n    \"BREAKFAST\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.booking) pm.collectionVariables.set('bookingId', d.booking.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Book without an account",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomTypeId\": \"{{roomTypeId}}\",\n  \"checkIn\": \"2026-12-14\",\n  \"checkOut\": \"2026-12-15\",\n  \"guest\": {\n    \"email\": \"walk.in@example.com\",\n    \"firstName\": \"Ngozi\",\n    \"lastName\": \"Eze\"\n  }\n}"
            }
          }
        },
        {
          "name": "Start payment (open authorizationUrl)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{guestToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/payments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.reference) pm.collectionVariables.set('reference', d.reference);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify payment",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{guestToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/payments/verify/{{reference}}"
          }
        },
        {
          "name": "My bookings",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{guestToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings"
          }
        },
        {
          "name": "One booking",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{guestToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{guestToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/cancel"
          }
        }
      ]
