{
  "info": {
    "name": "DGEP - SCRUM-32",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "guestId",
      "value": "paste-guest-id"
    },
    {
      "key": "bookingId",
      "value": "paste-booking-id"
    },
    {
      "key": "verificationId",
      "value": "paste-verification-id"
    },
    {
      "key": "requestId",
      "value": "paste-request-id"
    }
  ],
  "item": [
    {
      "name": "1. Check-in",
      "item": [
        {
          "name": "a. No login -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/check-in"
          }
        },
        {
          "name": "b. Someone else -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "someone-else"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/check-in"
          }
        },
        {
          "name": "c. Check-in status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/check-in"
          }
        },
        {
          "name": "d. Bad arrival time -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/check-in",
            "body": {
              "mode": "raw",
              "raw": "{\"arrivalTime\":\"2pm\"}"
            }
          }
        },
        {
          "name": "e. Check in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/check-in",
            "body": {
              "mode": "raw",
              "raw": "{\"arrivalTime\":\"14:30\",\"specialRequests\":\"Late arrival\"}"
            }
          }
        }
      ]
    },
    {
      "name": "2. ID verification",
      "item": [
        {
          "name": "Upload ID (choose a JPEG/PNG for idImage)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/id-verification",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "idType",
                  "value": "NIN",
                  "type": "text"
                },
                {
                  "key": "idNumber",
                  "value": "12345678901",
                  "type": "text"
                },
                {
                  "key": "idImage",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "selfie",
                  "type": "file",
                  "src": [],
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "ID status (guest)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/id-verification"
          }
        },
        {
          "name": "Staff: list pending",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/id-verifications?status=PENDING"
          }
        },
        {
          "name": "Staff: verify",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/id-verifications/{{verificationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"VERIFIED\"}"
            }
          }
        },
        {
          "name": "Staff: fail",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/id-verifications/{{verificationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"FAILED\",\"reason\":\"Photo is blurry\"}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Digital key",
      "item": [
        {
          "name": "Get key (QR code)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/key"
          }
        },
        {
          "name": "Unlock door",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/key/unlock"
          }
        }
      ]
    },
    {
      "name": "4. Concierge",
      "item": [
        {
          "name": "Services list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/concierge/services"
          }
        },
        {
          "name": "New request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/requests",
            "body": {
              "mode": "raw",
              "raw": "{\"serviceCode\":\"AIRPORT_PICKUP\",\"note\":\"Flight AA123\",\"scheduledFor\":\"2026-12-01T09:00:00+01:00\"}"
            }
          }
        },
        {
          "name": "Booking's requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/requests"
          }
        },
        {
          "name": "One request (with history)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/requests/{{requestId}}"
          }
        },
        {
          "name": "Guest: cancel",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{guestId}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/requests/{{requestId}}/cancel"
          }
        },
        {
          "name": "Staff: queue (open)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/requests?status=OPEN"
          }
        },
        {
          "name": "Staff: one request",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/requests/{{requestId}}"
          }
        },
        {
          "name": "Staff: start",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/requests/{{requestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"IN_PROGRESS\"}"
            }
          }
        },
        {
          "name": "Staff: done",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/requests/{{requestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"DONE\"}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Staff dashboard",
      "item": [
        {
          "name": "Overview (today)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/overview"
          }
        },
        {
          "name": "Overview (a date)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/overview?date=2026-12-01"
          }
        },
        {
          "name": "All bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/bookings"
          }
        },
        {
          "name": "Bookings: filter",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/bookings?status=CONFIRMED&from=2026-12-01&to=2026-12-31&search=john"
          }
        },
        {
          "name": "One booking",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Desk check-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/bookings/{{bookingId}}/check-in"
          }
        },
        {
          "name": "Guests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/guests?search=john"
          }
        },
        {
          "name": "Room availability",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "staff-1"
              },
              {
                "key": "X-User-Role",
                "value": "staff"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/rooms/availability?from=2026-12-01&to=2026-12-08"
          }
        }
      ]
    }
  ]
}
