{
  "info": {
    "name": "DGEP - SCRUM-32 Check-in",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "guestId",
      "value": "paste-guest-id"
    },
    {
      "key": "bookingId",
      "value": "paste-booking-id"
    }
  ],
  "item": [
    {
      "name": "a. No login -> 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/check-in"
      }
    },
    {
      "name": "b. Someone else -> 403",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "someone-else"
          }
        ],
        "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/check-in"
      }
    },
    {
      "name": "c. Check-in status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{guestId}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/check-in"
      }
    },
    {
      "name": "d. Bad arrival time -> 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{guestId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/check-in",
        "body": {
          "mode": "raw",
          "raw": "{\"arrivalTime\":\"2pm\"}"
        }
      }
    },
    {
      "name": "e. Check in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{guestId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}/check-in",
        "body": {
          "mode": "raw",
          "raw": "{\"arrivalTime\":\"14:30\",\"specialRequests\":\"Late arrival\"}"
        }
      }
    }
  ]
}