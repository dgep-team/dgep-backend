# Copy this file to .env and fill in your own values.
# Never commit .env: this repo is public.

NODE_ENV=development
PORT=3000

# PostgreSQL on Neon. Get both from the Neon console: Connect > copy the
# pooled URL into DATABASE_URL and the direct (unpooled) URL into DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Temporary login headers (X-User-Id, X-User-Role) until SCRUM-27.
# Default: on in development, off in production.
# AUTH_STUB=true

# Added later, when the tickets need them:
# JWT_SECRET=              (SCRUM-27 auth)
# PAYSTACK_SECRET_KEY=     (SCRUM-27 payments)
