# Copy this file to .env and fill in your own values.
# Never commit .env: this repo is public.

NODE_ENV=development
PORT=3000

# PostgreSQL on Neon. Get both from the Neon console: Connect > copy the
# pooled URL into DATABASE_URL and the direct (unpooled) URL into DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Header login for local testing (X-User-Id, X-User-Role).
# Default: on in development, off in production.
# AUTH_STUB=true

# Signs login tokens. Any long random text, e.g. from: openssl rand -hex 32
JWT_SECRET=

# Paystack, test mode: Dashboard > Settings > API Keys (sk_test_...)
PAYSTACK_SECRET_KEY=
# The frontend page Paystack sends guests back to, e.g. https://<frontend>/payment/callback
PAYSTACK_CALLBACK_URL=
