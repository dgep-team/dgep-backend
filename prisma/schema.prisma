// Database schema. After changing it, run: npm run db:migrate -- --name <what-changed>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled: used by the app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct: used by migrations
}

model Guest {
  id        String    @id @default(uuid())
  email     String    @unique
  firstName String
  lastName  String
  phone        String?
  passwordHash String? // null = booked without an account (PRD BR-09)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]

  @@map("guests")
}

// A hotel on the platform. Only ACTIVE hotels can take bookings.
model Hotel {
  id        String      @id @default(uuid())
  name      String
  city      String
  address   String
  phone     String?
  timezone  String      @default("Africa/Lagos") // IANA name; used for "today" and stay times
  status    HotelStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Listing details (PRD BR-02, BR-06, PC-05)
  description         String?
  photos              String[] @default([]) // image URLs
  amenities           String[] @default([]) // e.g. "Pool", "Free Wi-Fi"
  checkInTime         String   @default("14:00")
  checkOutTime        String   @default("12:00")
  arrivalInstructions String?
  parkingInfo         String?
  taxes               Json     @default("[]") // [{ name: "VAT", percent: 7.5 }], added to every stay

  rooms     Room[]
  roomTypes RoomType[]
  staff     Staff[]

  @@map("hotels")
}

enum HotelStatus {
  PENDING // onboarding: adding rooms and staff
  ACTIVE // live on the platform
  SUSPENDED // switched off by the platform team
}

// Hotel staff. Each person works for one hotel and only sees that hotel's data.
model Staff {
  id        String    @id @default(uuid())
  hotelId   String
  email     String    @unique
  firstName String
  lastName  String
  role         StaffRole
  passwordHash String? // set when the staff member is added; null = can't log in yet
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hotel            Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignedRequests ServiceRequest[]

  @@index([hotelId])
  @@map("staff")
}

enum StaffRole {
  MANAGER // can add rooms and staff
  RECEPTION
  HOUSEKEEPING
  MAINTENANCE
}

// What guests choose and compare, e.g. "Deluxe King" (PRD BR-04, BR-05).
model RoomType {
  id                 String   @id @default(uuid())
  hotelId            String
  name               String
  description        String?
  bedType            String // e.g. "1 king bed"
  maxGuests          Int
  sizeSqm            Int?
  view               String? // e.g. "Lagoon view"
  amenities          String[] @default([])
  accessibility      String[] @default([]) // e.g. "Step-free access"
  photos             String[] @default([]) // image URLs
  pricePerNight      Int // in kobo (Paystack's unit): ₦45,000 = 4500000
  cancellationPolicy String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hotel Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@unique([hotelId, name])
  @@map("room_types")
}

// A physical room, e.g. "204". Bookings are for a room; guests pick its type.
model Room {
  id         String    @id @default(uuid())
  hotelId    String
  roomTypeId String
  number     String // unique within its hotel
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bookings   Booking[]

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@unique([hotelId, number])
  @@index([roomTypeId])
  @@map("rooms")
}

enum BookingStatus {
  PENDING // created, not paid yet
  CONFIRMED // paid
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Booking {
  id          String        @id @default(uuid())
  guestId     String
  roomId      String
  checkIn     DateTime      @db.Date
  checkOut    DateTime      @db.Date
  status      BookingStatus @default(PENDING)
  totalAmount Int // in kobo
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Online check-in (SCRUM-32)
  arrivalTime     String? // "14:30"
  specialRequests String?
  onlineCheckInAt DateTime? // set when the guest finishes online check-in

  guest           Guest            @relation(fields: [guestId], references: [id], onDelete: Restrict)
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  idVerification  IdVerification?
  serviceRequests ServiceRequest[]

  // The migration also adds a database rule that blocks two active
  // bookings for the same room on overlapping dates.
  @@index([guestId])
  @@map("bookings")
}

enum IdType {
  NIN
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
}

enum VerificationStatus {
  PENDING // waiting for staff
  VERIFIED
  FAILED
}

// One ID check per booking. Uploading again replaces it and resets it to PENDING.
model IdVerification {
  id         String             @id @default(uuid())
  bookingId  String             @unique
  idType     IdType
  idNumber   String
  idImageKey String // file path in the private storage bucket, never a public URL
  selfieKey  String?
  status     VerificationStatus @default(PENDING)
  reason     String? // why it FAILED, shown to the guest
  reviewedBy String? // staff id
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("id_verifications")
}

enum RequestStatus {
  SUBMITTED
  IN_PROGRESS
  COMPLETED
  CANCELLED // by the guest, before staff start
}

// A guest's in-stay request, e.g. towels or a repair (PRD IS-01 to IS-06).
model ServiceRequest {
  id            String        @id @default(uuid())
  bookingId     String
  category      String // one of the codes in src/services/request.service.js
  note          String?
  preferredTime DateTime?
  status        RequestStatus @default(SUBMITTED)
  assignedToId  String? // the staff member doing it
  history       Json          @default("[]") // [{ at, byId, byRole, status? , assignedToId? }], oldest first
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignedTo Staff?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
  @@index([assignedToId])
  @@map("service_requests")
}

// The platform team: onboards hotels (/platform endpoints)
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("platform_admins")
}
